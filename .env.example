# Create a local .env file from this template. Never commit the real key.
# Get a key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Optional: override the RAG quiz-generation model.
GROQ_MODEL=openai/gpt-oss-20b
# Optional for a Render deployment (this is the default for any onrender.com frontend).
VITE_BACKEND_URL=https://air-gamepad-backend.onrender.com
